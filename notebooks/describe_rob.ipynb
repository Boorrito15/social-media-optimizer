    "missing_tt = undescribed_keys(tt_description_keys, tt_video_keys)\n",
    "print(len(missing_tt))\n",
    "missing_fb = undescribed_keys(fb_description_keys, fb_video_keys)\n",
    "print(len(missing_fb))\n",
