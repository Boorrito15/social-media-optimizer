# ==========================================
# GCP Project Configuration
# ==========================================
GCP_PROJECT_ID=le-wagon-2303
GCP_REGION=asia-southeast2

# ==========================================
# Google Cloud Storage (GCS)
# ==========================================
GCS_BUCKET_NAME=sm-optimizer-raw

# ==========================================
# AI Models & APIs
# ==========================================
# Option A: Gemini API Key (For Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key

# Option B: Vertex AI / GenAI SDK default (For GCP Vertex)
GOOGLE_API_KEY=your-google-api-key

# ==========================================
# GCP Authentication / Service Account
# ==========================================
# Path to your downloaded service account JSON key file (for local dev)
GOOGLE_APPLICATION_CREDENTIALS=config/service-account-key.json
