# =============================================================================
# Social Media Optimizer — Environment Variables
# Copy this file to `.env` and fill in your own values.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# GCP Project Configuration
# -----------------------------------------------------------------------------
# The GCP project id that hosts all resources (Compute Engine, GCS buckets).
GCP_PROJECT_ID=le-wagon-2303

# Default region/zone for Compute Engine resources.
GCP_REGION=asia-southeast2
GCP_ZONE=asia-southeast2-a

# -----------------------------------------------------------------------------
# Google Cloud Storage (GCS) buckets
# ---
# The project uses two buckets. Raw (unprocessed) source data and processed
# (cleaned/labelled) outputs are kept separate. Point these at the buckets you
# created (see `scripts/provision_gcp.sh`).
GCS_RAW_BUCKET=sm-optimizer-raw
GCS_PROCESSED_BUCKET=sm-optimizer-processed

# -----------------------------------------------------------------------------
# GCP Authentication / Service Account
# ---
# Path to the service-account JSON key used for local development. The key file
# is git-ignored; keep it out of version control.
#   Config dir:  config/  (key files here are git-ignored)
GOOGLE_APPLICATION_CREDENTIALS=config/le-wagon-2303-service-account.json

# -----------------------------------------------------------------------------
# AI Models & APIs — Gemini
# ---
# Gemini API key (Google AI Studio). Used when calling the Gemini models
# directly over the public API. Obtainable at
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optionally point to a Gemini model id if you are not using the default
# models.gemini-2.0-flash.
GEMINI_MODEL=models/gemini-2.0-flash

# -----------------------------------------------------------------------------
# AI Models & APIs — Vertex AI
# ---
# If you prefer to route through GCP Vertex AI (already authenticated via the
# service account above), set PROJECT_ID and REGION; the GenAI SDK will use
# the ADC credentials from GOOGLE_APPLICATION_CREDENTIALS.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=

# -----------------------------------------------------------------------------
# Data Configuration
# -----------------------------------------------------------------------------
# Path to the source master CSV (raw, un-cleaned).
RAW_DATA_PATH=data/raw/Post level data 2023 - 2026 - Funnel data.csv

# Path where the cleaned/deduped output is written.
CLEAN_DATA_PATH=data/processed/posts_clean.parquet

# -----------------------------------------------------------------------------
# Video Pipeline (scrape -> 480p -> GCS)
# ---
# Directory that temporary scraped/transcoded video files land in (should be
# git-ignored via data/videos/).
VIDEO_OUTPUT_DIR=data/videos

# GCS object prefix inside GCS_PROCESSED_BUCKET under which 480p videos are
# stored, e.g. `<prefix>/videos/<platform>/<post_id>.mp4`.
VIDEO_GCS_PREFIX=videos

# Target height for the transcode step (e.g. 480). Width is auto-derived to
# preserve aspect ratio.
VIDEO_TARGET_HEIGHT=480

# Video codec for the 480p re-encode: "h264" (libx264, playable everywhere) or
# "av1" (SVTAV1, ~30-50% smaller but slower; needs ffmpeg built with libsvtav1).
VIDEO_CODEC=h264

# CRF quality target (lower = better quality + larger file). Default 23.
VIDEO_CRF=23

# Optional path to a cookies file (Netscape format) for authenticated scraping
# (TikTok / Instagram / Facebook). Empty = anonymous.
YTDLP_COOKIES=

# Rate-limit / concurrency knobs.
VIDEO_CONCURRENCY=1
VIDEO_RETRIES=2
# Seconds to sleep before each download request (0 = no delay). A small value
# (e.g. 1-3) helps stay under anonymous-scrape throttling on YouTube.
VIDEO_REQUEST_DELAY=0
